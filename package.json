{
  "name": "gleaptracker",
  "version": "0.1.0",
  "private": true,
  "description": "Connect Gleap customer support with Slack, Linear, Jira, and GitHub. Created by the MapSVG team.",
  "license": "MIT",
  "author": {
    "name": "MapSVG team",
    "url": "https://mapsvg.com"
  },
  "homepage": "https://github.com/nlproduction/gleaptracker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nlproduction/gleaptracker.git"
  },
  "bugs": {
    "url": "https://github.com/nlproduction/gleaptracker/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config dist/src/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "config:export-previous": "node scripts/export-config.cjs",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop gleaptracker",
    "reload:pm2": "pm2 reload gleaptracker --update-env",
    "delete:pm2": "pm2 delete gleaptracker",
    "logs:pm2": "pm2 logs gleaptracker",
    "restart:pm2": "pm2 restart gleaptracker",
    "status:pm2": "pm2 status gleaptracker"
  },
  "dependencies": {
    "@linear/sdk": "^81.0.0",
    "@slack/web-api": "^7.19.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
