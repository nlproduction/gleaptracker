{
  "name": "gleaptracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config dist/src/server.js",
    "lint": "tsc --noEmit",
    "start:pm2": "pm2 start dist/src/server.js --name gleaptracker --node-args='-r dotenv/config' --env DOTENV_CONFIG_PATH=.env.local",
    "stop:pm2": "pm2 stop gleaptracker",
    "reload:pm2": "pm2 reload gleaptracker --update-env",
    "delete:pm2": "pm2 delete gleaptracker",
    "logs:pm2": "pm2 logs gleaptracker",
    "restart:pm2": "pm2 restart gleaptracker",
    "status:pm2": "pm2 status gleaptracker"
  },
  "dependencies": {
    "@linear/sdk": "^81.0.0",
    "@slack/web-api": "^7.15.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
