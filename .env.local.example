# Gleap
GLEAP_PROJECT_ID=
GLEAP_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Daily no-reply follow-up / close (node-cron in the Express process)
# Default: 0 8 * * * (08:00 UTC every day). Set `off` to disable.
# FOLLOWUP_CRON=0 8 * * *
# FOLLOWUP_TZ=UTC
# FOLLOWUP_AFTER_DAYS=3
# FOLLOWUP_CLOSE_AFTER_DAYS=7
# Optional overrides for the Gleap workflow IDs the cron invokes
# FOLLOWUP_BUG_FOLLOWUP_WORKFLOW_ID=66d638ab459ae610a55b625c
# FOLLOWUP_BUG_CLOSE_WORKFLOW_ID=66d639db15f03a3715a1c4a7
# FOLLOWUP_INQUIRY_CLOSE_WORKFLOW_ID=68942e98c7b00a2ffbb28be2

# GitHub webhook (`Fixes Gleap-<trackerBugId>` on push)
GITHUB_WEBHOOK_SECRET=

# Linear (optional / legacy — only if issueTracker is "linear" or "both")
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=

# Jira (optional / legacy — only if issueTracker is "jira" or "both")
JIRA_HOST=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
