# Required: Gleap project and Slack app
GLEAP_PROJECT_ID=
GLEAP_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Strongly recommended: protect the Gleap webhook using this shared secret.
# Send it as Authorization: Bearer <secret>, or as ?secret=<secret>.
GLEAP_WEBHOOK_SECRET=

# none | linear | jira | both. The Gleap/Slack workflow works with none.
ISSUE_TRACKER=none

# GitHub closing is optional. Default release branch remains master.
GITHUB_WEBHOOK_SECRET=
GITHUB_CLOSE_BRANCHES=master

# Linear: required only when enabling Linear issue creation
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=
# LINEAR_LABEL_IDS=label-uuid-1,label-uuid-2
# LINEAR_STATE_ID=
# LINEAR_TRACKER_LABEL=gleap-tracker-ticket

# Jira Cloud: required only when enabling Jira issue creation
JIRA_HOST=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
# JIRA_ISSUE_TYPE=Bug
# JIRA_DONE_STATUS=Done
# JIRA_DONE_STATUSES=Done,Released
# JIRA_LABELS=customer-reported

# Optional customer notification: workflow takes priority over default copy.
# GLEAP_CLOSE_WORKFLOW_ID=
# GLEAP_BUG_FIXED_MESSAGE="Your issue has been resolved. Reply to reopen this ticket."
# GLEAP_TRACKER_TICKET_TYPE=FOR-RELEASE
# GLEAP_DONE_STATUS=DONE

# Existing parked lanes can be excluded from no-reply follow-ups.
# GLEAP_ON_SLACK_BUG_STATUS=
# GLEAP_ON_SLACK_INQUIRY_STATUS=
# GLEAP_WAITING_STATUS=

# Disabled for new installs. Configure your own workflows before enabling.
FOLLOWUP_CRON=off
# FOLLOWUP_CRON=0 8 * * *
# FOLLOWUP_TZ=UTC
# FOLLOWUP_AFTER_DAYS=3
# FOLLOWUP_CLOSE_AFTER_DAYS=7
FOLLOWUP_BUG_FOLLOWUP_WORKFLOW_ID=
FOLLOWUP_BUG_CLOSE_WORKFLOW_ID=
FOLLOWUP_INQUIRY_CLOSE_WORKFLOW_ID=

# PORT=3000
